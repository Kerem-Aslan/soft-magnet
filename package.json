{
  "name": "soft-magnet",
  "version": "0.1.0",
  "description": "A subtle magnetic hover effect: elements lean toward the cursor and grow a little, with spring motion. No dependencies, React hook included.",
  "keywords": [
    "magnetic",
    "magnet",
    "hover",
    "cursor",
    "spring",
    "animation",
    "button",
    "react",
    "hook"
  ],
  "license": "MIT",
  "author": "Kerem-Aslan",
  "homepage": "https://github.com/Kerem-Aslan/soft-magnet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kerem-Aslan/soft-magnet.git"
  },
  "bugs": "https://github.com/Kerem-Aslan/soft-magnet/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "demo": "npm run build && node demo/serve.mjs",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5.9"
  }
}
